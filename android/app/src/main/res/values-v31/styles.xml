<resources>
<style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowLightStatusBar">@bool/system_bar_light</item>
    <item name="android:windowLightNavigationBar">@bool/system_bar_light</item>
    <item name="android:enforceStatusBarContrast">false</item>
    <item name="android:enforceNavigationBarContrast">false</item>
    <item name="android:statusBarColor">@color/system_bar_surface</item>
    <item name="android:navigationBarColor">@color/system_bar_surface</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:colorAccent">#3276F5</item>
    <item name="android:windowBackground">@drawable/launch_background</item>
    <item name="android:windowSplashScreenBackground">#101E3D</item>
    <item name="android:windowSplashScreenIconBackgroundColor">#101E3D</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_empty</item>
    <item name="android:windowSplashScreenAnimationDuration">0</item>
    <item name="android:forceDarkAllowed">false</item>
</style>
</resources>
