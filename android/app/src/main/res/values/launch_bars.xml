<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Explicit overrides also cover an app theme different from the system theme. -->
    <style name="LaunchBarsLight">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:statusBarColor">#F3F5F9</item>
        <item name="android:navigationBarColor">#F3F5F9</item>
    </style>
    <style name="LaunchBarsDark">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:statusBarColor">#101827</item>
        <item name="android:navigationBarColor">#101827</item>
    </style>
</resources>
